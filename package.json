{
  "name": "vue-cornerstone3d",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:subpath": "cross-env BASE_PATH=/subpath/ vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:subpath": "cross-env BASE_PATH=/subpath/ npm run build",
    "preview": "vite preview",
    "preview:subpath": "cross-env BASE_PATH=/subpath/ vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force"
  },
  "dependencies": {
    "@cornerstonejs/calculate-suv": "1.1.0",
    "@cornerstonejs/core": "^4.17.4",
    "@cornerstonejs/dicom-image-loader": "^4.17.4",
    "@cornerstonejs/tools": "^4.17.4",
    "dcmjs": "0.33.0",
    "dicom-parser": "1.8.21",
    "dicomweb-client": "0.11.2",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@originjs/vite-plugin-commonjs": "^1.0.3",
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^20.17.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitejs/plugin-vue-jsx": "^4.0.1",
    "@vue/tsconfig": "^0.5.1",
    "cross-env": "^7.0.3",
    "npm-run-all2": "^7.0.1",
    "typescript": "~5.6.0",
    "vite": "^5.4.10",
    "vue-tsc": "^2.1.6"
  }
}
